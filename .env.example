# copy to .env (gitignored) and adjust. The runner loads it automatically.

# --- where / what -------------------------------------------------------
AWS_REGION=eu-west-1          # keep constant for the whole study
STAGE=dev                     # dev | pilot | exp
STACK_NAME=sqs-rr-dev
DRY_RUN=1                     # 1 = local simulator (free), 0 = live AWS (also needs --live)

# --- single ad-hoc run (python -m src.control.experiment_runner --from-env)
FAULT_MODE=none               # none|consumer_kill|unhandled_error|datastore_reject|datastore_timeout
FAULT_RATE=0.0                # probability per record at the injection point
FAULT_WINDOW_SEC=60
VISIBILITY_TIMEOUT=30
MAX_RECEIVE_COUNT=5
BATCH_SIZE=10
ORDER_COUNT=1000              # pilot small; scale toward baseline comparability
LOAD_PROFILE=normal           # normal | burst | batch
RUN_ID=                       # empty = derived from the config hash

# --- cost control -------------------------------------------------------
ENABLE_COST_GUARD=1
MAX_ESTIMATED_USD=5.00
